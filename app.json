{
  "expo": {
    "name": "dsc-app",
    "slug": "dsc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dcc-logo.jpg",
    "scheme": "dscapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dcc-logo.jpg",
      "themeColor": "#0B0B0D",
      "name": "Deluxe Car Club",
      "shortName": "DCC",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "backgroundColor": "#0B0B0D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dcc-logo.jpg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0D",
          "dark": {
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Deluxe Car Club uses the camera to scan member QR codes at events for check-in.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
