# Copy this file to `.env.local` and fill in real values.
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and visible to clients —
# never put secret keys in this file.

# ---- Supabase ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Stripe ----
# Used in Phase 3 for the $50 application fee.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Server-side only (do NOT prefix with EXPO_PUBLIC_) ----
# Set these on whatever platform runs the application-fee webhook
# (e.g. Supabase Edge Functions). They are read by server code only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
